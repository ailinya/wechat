# 复制为根目录 .env 并填写真实值。.env 已被 .gitignore 忽略，不得提交。
# 启动：在仓库根目录执行 docker compose up -d
# 若宿主机 5432/6379/9000/9001 已被占用，可改下面的 *_PORT 映射到其他宿主端口
# （容器内端口不变），并同步更新 DATABASE_URL。

# PostgreSQL + pgvector
POSTGRES_DB=wetchat
POSTGRES_USER=wetchat
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_PORT=5432

# Redis（Celery broker）
REDIS_PORT=6379

# RustFS（对象存储）
RUSTFS_ACCESS_KEY=replace-with-access-key
RUSTFS_SECRET_KEY=replace-with-secret-key
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# 后端连接串（供应用与迁移使用；主机/端口/账号需与上面一致）。
# 用 127.0.0.1 而非 localhost，避免本机 IPv6 解析导致连接挂起。
DATABASE_URL=postgresql+psycopg://wetchat:replace-with-a-strong-password@127.0.0.1:5432/wetchat

# Redis（Celery broker；端口与上面 REDIS_PORT 一致，宿主机端口冲突时先改 *_PORT）
REDIS_URL=redis://127.0.0.1:6379/0

# RustFS（S3 兼容对象存储；RUSTFS_ENDPOINT 指向宿主机映射端口）
RUSTFS_ENDPOINT=http://127.0.0.1:9000

# 异步任务约束（可选，以下为默认值）
# JOB_MAX_ATTEMPTS=3
# JOB_RETRY_BACKOFF_SECONDS=5
# JOB_SOFT_TIME_LIMIT_SECONDS=300
# JOB_STALE_TIMEOUT_MINUTES=30
